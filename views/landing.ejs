<!doctype html>
<html lang="es">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/header') %>

  <main>
    <%# ---- HERO ---------------------------------------------------------- %>
    <section class="hero">
      <img class="hero__deco hero__deco--cocos" src="/img/cocos.png" alt="" aria-hidden="true">
      <img class="hero__deco hero__deco--chiris" src="/img/chirimoyas.png" alt="" aria-hidden="true">

      <%# Burbujas de fondo. Los valores estan fijos a proposito para que el
          HTML no cambie en cada visita. Cada fila es: izquierda, tamano,
          duracion y retraso. --%>
      <div class="burbujas" aria-hidden="true">
        <% [[4,14,13,0],[12,8,10,-3],[19,22,16,-7],[27,10,11,-1],[34,16,14,-9],
            [43,7,9,-4],[51,20,15,-12],[58,11,12,-2],[66,26,18,-6],[73,9,10,-8],
            [80,17,13,-5],[87,12,11,-11],[93,21,16,-3],[97,8,9,-7]].forEach(function (b) { %>
          <span style="left:<%= b[0] %>%;width:<%= b[1] %>px;height:<%= b[1] %>px;animation-duration:<%= b[2] %>s;animation-delay:<%= b[3] %>s"></span>
        <% }) %>
      </div>

      <div class="contenedor hero__grilla">
        <div class="hero__texto">
          <p class="etiqueta">0 azúcar</p>
          <h1>Todo el sabor.<br>Cero vueltas.</h1>
          <p class="hero__bajada">
            Burbujas, fruta y cuatro sabores que no se parecen a lo de siempre.
          </p>
          <div class="hero__acciones">
            <a class="boton boton--principal" href="#sabores">Descubrir sabores ↓</a>
            <% if (site.whatsapp) { %>
              <a class="boton boton--linea" href="<%= site.wa('Hola! Quiero pedir Frisch.') %>"
                 target="_blank" rel="noopener">Pedir por WhatsApp ↗</a>
            <% } %>
          </div>
        </div>

        <div class="hero__botellas">
          <img src="/img/botella-chirimoya.png" alt="Frisch Chirimoya" width="667" height="1000">
          <img src="/img/botella-cocoloco.png" alt="Frisch Coco Loco" width="631" height="1000">
        </div>
      </div>

      <a class="bajar" href="#video" aria-label="Seguir bajando">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M6 9l6 6 6-6"/>
        </svg>
      </a>

      <%# Onda decorativa que empalma con el color de fondo de la pagina. %>
      <svg class="onda" viewBox="0 0 1440 90" preserveAspectRatio="none" aria-hidden="true">
        <path fill="#fff8ef" d="M0,45 C240,90 480,0 720,25 C960,50 1200,90 1440,55 L1440,90 L0,90 Z"></path>
      </svg>
    </section>

    <%# ---- VIDEO ----------------------------------------------------------
        Si VIDEO_URL trae una URL de insercion se usa un iframe; si no, se
        sirve el archivo propio de /video. preload="none" hace que el video
        solo se descargue cuando alguien le da play.
    --%>
    <section class="seccion seccion--morada" id="video">
      <div class="contenedor video-bloque revelar">
        <div class="video-bloque__llamada">
          <img src="/img/mira-video.png" alt="Mira el video" loading="lazy">
        </div>
        <div class="video-marco">
          <% if (site.video) { %>
            <iframe src="<%= site.video %>" title="Video de Frisch"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen loading="lazy"></iframe>
          <% } else { %>
            <video controls preload="none" playsinline poster="/img/portada-video.jpg">
              <source src="/video/frisch.mp4" type="video/mp4">
              Tu navegador no puede reproducir este video.
            </video>
          <% } %>
        </div>
      </div>
    </section>

    <%# ---- SABORES --------------------------------------------------------
        Las tarjetas son tipograficas a proposito: solo hay foto de botella
        de Chirimoya y Coco. Cuando lleguen las de Guayaba y Achachairu se
        pueden agregar sin romper el diseno.
    --%>
    <section class="seccion" id="sabores">
      <div class="contenedor">
        <p class="etiqueta">Elegí tu mood</p>
        <h2>Cuatro formas de<br>sentir lo Frisch.</h2>
        <p class="seccion__bajada">
          Sabores tropicales con personalidad propia. Probá uno o armá tu combo.
        </p>

        <div class="sabores">
          <%
            const sabores = [
              { n: '01', sigla: 'G',  mood: 'Vibrante',  nombre: 'Guayaba',    tono: '#e8455f' },
              { n: '02', sigla: 'Ch', mood: 'Suave',     nombre: 'Chirimoya',  tono: '#9b47c9' },
              { n: '03', sigla: 'C',  mood: 'Inesperado',nombre: 'Coco',       tono: '#f2c14e' },
              { n: '04', sigla: 'A',  mood: 'Amazónico', nombre: 'Achachairú', tono: '#f2872f' },
            ];
          %>
          <% sabores.forEach(function (s, i) { %>
            <a class="sabor revelar<%= i % 3 ? ' revelar--' + ((i % 3) + 1) : '' %>"
               style="--tono:<%= s.tono %>"
               <% if (site.whatsapp) { %>href="<%= site.wa('Hola! Quiero pedir Frisch ' + s.nombre + '.') %>" target="_blank" rel="noopener"<% } else { %>href="#comprar"<% } %>>
              <span class="sabor__numero"><%= s.n %></span>
              <span class="sabor__sigla" aria-hidden="true"><%= s.sigla %></span>
              <span class="sabor__mood"><%= s.mood %></span>
              <h3><%= s.nombre %></h3>
              <span class="sabor__flecha" aria-hidden="true">↗</span>
            </a>
          <% }) %>
        </div>
      </div>
    </section>

    <%# ---- BOTELLAS --------------------------------------------------------
        Solo se listan los sabores que tienen foto. Para sumar Guayaba o
        Achachairu cuando lleguen sus fotos, basta con agregar una fila al
        arreglo de abajo: el resto se arma solo.
    --%>
    <%
      const botellas = [
        { nombre: 'Chirimoya', img: '/img/botella-chirimoya.png',
          fondo: '/img/patron-chirimoya.jpg',
          texto: 'Dulce, cremosa y distinta. La fruta que todos conocen, como nunca la probaste.' },
        { nombre: 'Coco Loco', img: '/img/botella-cocoloco.png',
          fondo: '/img/patron-coco.jpg',
          texto: 'Coco de verdad, suave y tropical. El que nadie espera encontrar en una gaseosa.' },
      ];
    %>
    <% if (botellas.length) { %>
      <section class="seccion" id="botellas">
        <div class="contenedor">
          <p class="etiqueta">En botella</p>
          <h2>Así se ven</h2>
          <p class="seccion__bajada">
            Fría, con la burbuja justa y lista para abrir.
          </p>

          <div class="botellas">
            <% botellas.forEach(function (b, i) { %>
              <article class="botella-card revelar<%= i ? ' revelar--2' : '' %>"
                       style="--fondo:url('<%= b.fondo %>')">
                <img class="botella-card__foto" src="<%= b.img %>"
                     alt="Botella de Frisch <%= b.nombre %>" loading="lazy">
                <span class="sabor__pastilla">Cero azúcar</span>
                <h3><%= b.nombre %></h3>
                <p><%= b.texto %></p>
              </article>
            <% }) %>
          </div>
        </div>
      </section>
    <% } %>

    <%# ---- FRANJA TROPICAL ------------------------------------------------ %>
    <section class="franja">
      <div class="contenedor revelar">
        <h2>Hecha para refrescar distinto</h2>
        <p>Tomala bien fría. Es cuando mejor se siente.</p>
      </div>
    </section>

    <%# ---- LA MARCA -------------------------------------------------------- %>
    <section class="seccion beneficios" id="marca">
      <div class="contenedor">
        <p class="etiqueta">Lo simple sabe mejor</p>
        <h2>Sin azúcar.<br>Con toda la actitud.</h2>
        <p class="seccion__bajada">
          Una gaseosa fresca, con sabores nacidos de nuestra tierra y una
          propuesta hecha para quienes quieren elegir distinto.
        </p>

        <div class="beneficios__grilla">
          <article class="revelar">
            <span class="beneficios__cifra">0</span>
            <h3>azúcar</h3>
            <p>Toda la gaseosa, sin el azúcar. Sin renunciar al sabor ni a la burbuja.</p>
          </article>
          <article class="revelar revelar--2">
            <span class="beneficios__cifra">4</span>
            <h3>sabores</h3>
            <p>Guayaba, chirimoya, coco y achachairú. Frutas de acá, en formato gaseosa.</p>
          </article>
          <article class="revelar revelar--3">
            <span class="beneficios__cifra">100%</span>
            <h3>actitud tropical</h3>
            <p>Producción nacional, pensada para el gusto de acá.</p>
          </article>
        </div>
      </div>
    </section>

    <%# ---- DONDE COMPRAR ---------------------------------------------------
        Canales tomados de las publicaciones de la marca.
        PROVISIONAL: falta el enlace directo de PedidosYa y el de la app propia.
    --%>
    <section class="seccion" id="comprar">
      <div class="contenedor">
        <p class="etiqueta">Dónde comprar</p>
        <h2>Nos encontrás acá</h2>
        <p class="seccion__bajada">
          En supermercados, por delivery y en puntos de venta seleccionados.
          Si no la ves en tu zona, escribinos y te decimos dónde conseguirla.
        </p>

        <div class="puntos">
          <article class="punto revelar">
            <h3>Hipermaxi</h3>
            <p>En la góndola de bebidas de tus sucursales de siempre.</p>
          </article>
          <article class="punto revelar revelar--2">
            <h3>PedidosYa</h3>
            <p>Pedila por delivery y te llega fría a la puerta.</p>
          </article>
          <article class="punto revelar revelar--3">
            <h3>Market Tu Súper</h3>
            <p>Disponible también en Market Tu Súper.</p>
          </article>
        </div>
      </div>
    </section>

    <%# ---- CIERRE ---------------------------------------------------------- %>
    <section class="cierre">
      <div class="contenedor cierre__caja revelar">
        <p class="etiqueta etiqueta--clara">¿Ya elegiste?</p>
        <h2>Tu próximo sabor<br>favorito está acá.</h2>
        <div class="cierre__acciones">
          <% if (site.whatsapp) { %>
            <a class="boton boton--principal" href="<%= site.wa('Hola! Quiero pedir Frisch.') %>"
               target="_blank" rel="noopener">Pedir por WhatsApp ↗</a>
          <% } %>
          <a class="boton boton--linea" href="#sabores">Ver los sabores</a>
        </div>
      </div>
    </section>
  </main>

  <%- include('partials/footer') %>
</body>
</html>
