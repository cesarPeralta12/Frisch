<!doctype html>
<html lang="es">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/header') %>

  <main>
    <%# ---- HERO ---------------------------------------------------------- %>
    <section class="hero">
      <img class="hero__deco hero__deco--cocos" src="/img/cocos.png" alt="" aria-hidden="true">
      <img class="hero__deco hero__deco--chiris" src="/img/chirimoyas.png" alt="" aria-hidden="true">

      <div class="contenedor hero__grilla">
        <div class="hero__texto">
          <p class="etiqueta">Bebida gaseosa sin azucar</p>
          <h1>Atrevete<br>a lo nuevo.</h1>
          <p class="hero__bajada">
            El sabor que sorprende. Chirimoya y Coco Loco, dos sabores
            bolivianos con toda la burbuja y cero azucar.
          </p>
          <div class="hero__acciones">
            <a class="boton boton--principal" href="#sabores">Ver los sabores</a>
            <a class="boton boton--linea" href="#comprar">Donde comprar</a>
          </div>
        </div>

        <div class="hero__botellas">
          <img src="/img/botella-chirimoya.png" alt="Frisch Chirimoya" width="667" height="1000">
          <img src="/img/botella-cocoloco.png" alt="Frisch Coco Loco" width="631" height="1000">
        </div>
      </div>

      <%# Onda decorativa que empalma con el color de fondo de la pagina. %>
      <svg class="onda" viewBox="0 0 1440 90" preserveAspectRatio="none" aria-hidden="true">
        <path fill="#fff8ef" d="M0,45 C240,90 480,0 720,25 C960,50 1200,90 1440,55 L1440,90 L0,90 Z"></path>
      </svg>
    </section>

    <%# ---- SABORES --------------------------------------------------------
        Solo hay material grafico de Chirimoya y Coco Loco. Si la empresa
        confirma un tercer sabor, se agrega una tarjeta mas con su foto.
    --%>
    <section class="seccion" id="sabores">
      <div class="contenedor">
        <p class="etiqueta">Nuestra linea</p>
        <h2>Dos sabores que no veias venir</h2>
        <p class="seccion__bajada">
          Frutas de aca, en formato gaseosa. Sin azucar, sin quedarse corto
          de sabor.
        </p>

        <div class="sabores">
          <article class="sabor" style="--fondo:url('/img/patron-chirimoya.jpg')">
            <img class="sabor__botella" src="/img/botella-chirimoya.png"
                 alt="Botella de Frisch Chirimoya" loading="lazy">
            <span class="sabor__pastilla">Cero azucar</span>
            <h3>Chirimoya</h3>
            <p>Dulce, cremosa y distinta. La fruta que todos conocen, como nunca la probaste.</p>
          </article>

          <article class="sabor" style="--fondo:url('/img/patron-coco.jpg')">
            <img class="sabor__botella" src="/img/botella-cocoloco.png"
                 alt="Botella de Frisch Coco Loco" loading="lazy">
            <span class="sabor__pastilla">Cero azucar</span>
            <h3>Coco Loco</h3>
            <p>Coco de verdad, suave y tropical. El que nadie espera encontrar en una gaseosa.</p>
          </article>
        </div>
      </div>
    </section>

    <%# ---- VIDEO ----------------------------------------------------------
        La seccion solo aparece si VIDEO_URL esta configurada en Coolify.
        Debe ser una URL de insercion (embed), no la del navegador.
    --%>
    <% if (site.video) { %>
      <section class="seccion seccion--morada" id="video">
        <div class="contenedor video-bloque">
          <div class="video-bloque__llamada">
            <img src="/img/mira-el-video.png" alt="Mira el video" loading="lazy">
          </div>
          <div class="video-marco">
            <iframe src="<%= site.video %>" title="Video de Frisch"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen loading="lazy"></iframe>
          </div>
        </div>
      </section>
    <% } %>

    <%# ---- FRANJA TROPICAL ------------------------------------------------ %>
    <section class="franja">
      <div class="contenedor">
        <h2>El sabor que sorprende</h2>
        <p>Tomala bien fria. Es cuando mejor se siente.</p>
      </div>
    </section>

    <%# ---- BENEFICIOS ------------------------------------------------------ %>
    <section class="seccion beneficios" id="marca">
      <div class="contenedor">
        <p class="etiqueta">La marca</p>
        <h2>Sin azucar, sin excusas</h2>
        <p class="seccion__bajada">
          Frisch nacio de una idea sencilla: que una gaseosa sin azucar no
          tenia por que saber a menos, y que en vez de copiar los sabores de
          siempre valia la pena usar los nuestros.
        </p>

        <div class="beneficios__grilla">
          <article>
            <span class="beneficios__cifra">0 g</span>
            <h3>Cero azucar</h3>
            <p>Toda la gaseosa, sin el azucar. Sin renunciar al sabor ni a la burbuja.</p>
          </article>
          <article>
            <span class="beneficios__cifra">2</span>
            <h3>Sabores nuestros</h3>
            <p>Chirimoya y Coco Loco. Frutas que ya conoces, en un formato que no esperabas.</p>
          </article>
          <article>
            <span class="beneficios__cifra">100%</span>
            <h3>Boliviana</h3>
            <p>Produccion nacional, pensada para el gusto de aca.</p>
          </article>
        </div>
      </div>
    </section>

    <%# ---- DONDE COMPRAR ---------------------------------------------------
        Canales tomados de las publicaciones de la marca.
        PROVISIONAL: falta el enlace directo de PedidosYa y el de la app propia.
    --%>
    <section class="seccion" id="comprar">
      <div class="contenedor">
        <p class="etiqueta">Donde comprar</p>
        <h2>Nos encuentras aca</h2>
        <p class="seccion__bajada">
          En supermercados, por delivery y en puntos de venta seleccionados.
          Si no la ves en tu zona, escribenos y te decimos donde conseguirla.
        </p>

        <div class="puntos">
          <article class="punto">
            <h3>Hipermaxi</h3>
            <p>En la gondola de bebidas de tus sucursales de siempre.</p>
          </article>
          <article class="punto">
            <h3>PedidosYa</h3>
            <p>Pidela por delivery y te llega fria a la puerta.</p>
          </article>
          <article class="punto">
            <h3>Market Tu Super</h3>
            <p>Disponible tambien en Market Tu Super.</p>
          </article>
        </div>

        <div class="cta-caja">
          <div>
            <h3>Quieres vender Frisch?</h3>
            <p>Si tienes un negocio y te interesa distribuir la marca, hablemos.</p>
          </div>
          <div class="cta-caja__acciones">
            <% if (site.whatsapp) { %>
              <a class="boton boton--principal" href="https://wa.me/<%= site.whatsapp %>">WhatsApp</a>
            <% } %>
            <a class="boton boton--linea" href="mailto:<%= site.email %>">Escribir un correo</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <%- include('partials/footer') %>
</body>
</html>
