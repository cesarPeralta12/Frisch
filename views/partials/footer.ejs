<footer class="pie" id="contacto">
  <div class="contenedor pie__grilla">
    <div>
      <img class="pie__logo" src="/img/logo.png" alt="<%= site.name %>" loading="lazy">
      <p class="pie__lema"><%= site.tagline %></p>
      <p><%= site.location %></p>
    </div>

    <div>
      <p class="pie__titulo">Contacto</p>
      <p><a href="mailto:<%= site.email %>"><%= site.email %></a></p>
      <% if (site.whatsapp) { %>
        <p><a href="https://wa.me/<%= site.whatsapp %>">Escribenos por WhatsApp</a></p>
      <% } %>
    </div>

    <div>
      <p class="pie__titulo">Siguenos</p>
      <p><a href="<%= site.instagram %>" target="_blank" rel="noopener">Instagram</a></p>
      <p><a href="<%= site.tiktok %>" target="_blank" rel="noopener">TikTok</a></p>
    </div>
  </div>

  <div class="contenedor pie__legal">
    <p>&copy; <%= site.year %> <%= site.name %>. Todos los derechos reservados.</p>
  </div>
</footer>

<script src="/js/main.js?v=<%= site.v %>" defer></script>
