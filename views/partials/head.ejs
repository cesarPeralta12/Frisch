<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= site.name %> · <%= site.tagline %></title>
<meta name="description" content="<%= site.name %>, bebida gaseosa sin azucar. Atrevete a lo nuevo, el sabor que sorprende. Chirimoya y Coco Loco, hechas en Bolivia.">
<meta name="theme-color" content="#6a1f88">

<%# Etiquetas para cuando se comparta el enlace en WhatsApp o redes. %>
<meta property="og:type" content="website">
<meta property="og:title" content="<%= site.name %> · <%= site.tagline %>">
<meta property="og:description" content="Atrevete a lo nuevo, el sabor que sorprende. Cero azucar.">
<meta property="og:site_name" content="<%= site.name %>">
<meta property="og:image" content="/img/banner-playa.jpg">

<link rel="icon" href="/img/favicon.png" type="image/png">
<link rel="apple-touch-icon" href="/img/favicon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<%# Asap es la tipografia de marca (esta en Google Fonts, licencia libre).
    Fredoka acompana en los titulos por ser redondeada como el logotipo. %>
<link href="https://fonts.googleapis.com/css2?family=Asap:wght@400;500;600&family=Fredoka:wght@500;600;700&display=swap" rel="stylesheet">
